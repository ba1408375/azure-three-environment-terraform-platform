name: devcloud-platform

x-logging: &default-logging
  driver: json-file
  options:
    max-size: "10m"
    max-file: "3"

services:
  ar:
    image: ${jsonencode(images.static_web)}
    container_name: ar-service
    restart: unless-stopped
    ports:
      - "8092:80"
    volumes:
      - /opt/platform/ar:/usr/share/nginx/html:ro
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "-", "http://127.0.0.1/healthz"]
      interval: 30s
      timeout: 5s
      retries: 5
    mem_limit: 256m
    cpus: 0.25
    logging: *default-logging
    networks: [platform]

  vr:
    image: ${jsonencode(images.static_web)}
    container_name: vr-service
    restart: unless-stopped
    ports:
      - "8093:80"
    volumes:
      - /opt/platform/vr:/usr/share/nginx/html:ro
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "-", "http://127.0.0.1/healthz"]
      interval: 30s
      timeout: 5s
      retries: 5
    mem_limit: 256m
    cpus: 0.25
    logging: *default-logging
    networks: [platform]

  tensorflow-serving:
    image: ${jsonencode(images.tensorflow)}
    container_name: tensorflow-serving
    restart: unless-stopped
    environment:
      MODEL_NAME: half_plus_two
    ports:
      - "8501:8501"
    volumes:
      - /opt/platform/models/half_plus_two:/models/half_plus_two:ro
    healthcheck:
      test: ["CMD-SHELL", "timeout 5 bash -c '</dev/tcp/127.0.0.1/8501'"]
      interval: 30s
      timeout: 10s
      retries: 10
      start_period: 60s
    mem_limit: 2g
    cpus: 1.0
    logging: *default-logging
    networks: [platform]

  kong:
    image: ${jsonencode(images.kong)}
    container_name: api-management-kong
    restart: unless-stopped
    environment:
      KONG_DATABASE: "off"
      KONG_DECLARATIVE_CONFIG: /kong/declarative/kong.yml
      KONG_PROXY_ACCESS_LOG: /dev/stdout
      KONG_ADMIN_ACCESS_LOG: /dev/stdout
      KONG_PROXY_ERROR_LOG: /dev/stderr
      KONG_ADMIN_ERROR_LOG: /dev/stderr
      KONG_ADMIN_LISTEN: 0.0.0.0:8001
    ports:
      - "8000:8000"
      - "127.0.0.1:8001:8001"
    volumes:
      - /opt/platform/kong/kong.yml:/kong/declarative/kong.yml:ro
    depends_on:
      ar:
        condition: service_healthy
      vr:
        condition: service_healthy
      tensorflow-serving:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "kong", "health"]
      interval: 30s
      timeout: 10s
      retries: 10
      start_period: 30s
    mem_limit: 1g
    cpus: 0.75
    logging: *default-logging
    networks: [platform]

  nifi:
    image: ${jsonencode(images.nifi)}
    container_name: data-management-nifi
    restart: unless-stopped
    environment:
      SINGLE_USER_CREDENTIALS_USERNAME: ${jsonencode(nifi_username)}
      SINGLE_USER_CREDENTIALS_PASSWORD: ${jsonencode(nifi_password)}
      NIFI_WEB_HTTPS_PORT: "8443"
      NIFI_JVM_HEAP_INIT: 1g
      NIFI_JVM_HEAP_MAX: 3g
    ports:
      - "127.0.0.1:8443:8443"
    volumes:
      - nifi_conf:/opt/nifi/nifi-current/conf
      - nifi_database:/opt/nifi/nifi-current/database_repository
      - nifi_flowfile:/opt/nifi/nifi-current/flowfile_repository
      - nifi_content:/opt/nifi/nifi-current/content_repository
      - nifi_provenance:/opt/nifi/nifi-current/provenance_repository
      - nifi_state:/opt/nifi/nifi-current/state
      - nifi_logs:/opt/nifi/nifi-current/logs
    healthcheck:
      test: ["CMD-SHELL", "timeout 5 bash -c '</dev/tcp/127.0.0.1/8443'"]
      interval: 30s
      timeout: 10s
      retries: 20
      start_period: 180s
    mem_limit: 4g
    cpus: 1.5
    logging: *default-logging
    networks: [platform]

  mediamtx:
    image: ${jsonencode(images.mediamtx)}
    container_name: vaas-mediamtx
    restart: unless-stopped
    ports:
      - "1935:1935/tcp"
      - "8554:8554/tcp"
      - "8891:8888/tcp"
      - "8889:8889/tcp"
      - "8000-8001:8000-8001/udp"
      - "8189:8189/udp"
      - "8890:8890/udp"
    volumes:
      - mediamtx_recordings:/recordings
    healthcheck:
      test: ["CMD", "/mediamtx", "--version"]
      interval: 30s
      timeout: 5s
      retries: 5
    mem_limit: 1g
    cpus: 0.75
    logging: *default-logging
    networks: [platform]

networks:
  platform:
    name: devcloud-platform

volumes:
  nifi_conf:
  nifi_database:
  nifi_flowfile:
  nifi_content:
  nifi_provenance:
  nifi_state:
  nifi_logs:
  mediamtx_recordings:
